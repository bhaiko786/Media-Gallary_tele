# Google OAuth (NextAuth) — create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:4000

# Telegram Bot API — create a bot via https://t.me/BotFather to get the token,
# and get your chat/channel ID by messaging the bot and checking the getUpdates response
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
